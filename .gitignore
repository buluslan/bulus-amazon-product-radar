# macOS 系统文件
.DS_Store

# Python 缓存
__pycache__/
*.pyc

# 编辑器/IDE
.vscode/
.idea/

# 运行时产物(不进库)
.flow_state/
.run_output/
选品雷达报告/
.sorftime_cache/

# 用户配置 + 产物(install 写入 / 报告 / 归档临时对话)
.env
!.env.example
reports/
.conversation-*.md

# A-lite 端到端测试临时文件(不进git)
.env.e2e
payload_e2e.json
